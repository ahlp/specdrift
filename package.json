{
  "name": "@ahlp/sdd",
  "version": "0.1.0",
  "description": "Semantic OpenSpec validation CLI: compare specs against repository code using AI",
  "type": "module",
  "bin": {
    "sdd": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openspec",
    "sdd",
    "spec-driven-development",
    "validation",
    "ai",
    "lmstudio",
    "ollama",
    "deepseek",
    "cli"
  ],
  "license": "MIT",
  "author": "Arthur Pires",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/ahlp/sdd.git"
  },
  "homepage": "https://gitlab.com/ahlp/sdd#readme",
  "bugs": {
    "url": "https://gitlab.com/ahlp/sdd/-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ignore": "^5.3.2",
    "minimatch": "^9.0.9",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
